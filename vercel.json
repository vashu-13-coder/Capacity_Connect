{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://capacity-connect-bdxd.onrender.com/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://capacity-connect-bdxd.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*/",
      "destination": "https://capacity-connect-bdxd.onrender.com/admin/:path*/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://capacity-connect-bdxd.onrender.com/admin/:path*"
    },
    {
      "source": "/static/admin/:path*",
      "destination": "https://capacity-connect-bdxd.onrender.com/static/admin/:path*"
    },
    {
      "source": "/static/rest_framework/:path*",
      "destination": "https://capacity-connect-bdxd.onrender.com/static/rest_framework/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
